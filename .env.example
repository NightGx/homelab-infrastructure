# ==========================================
# Homelab Infrastructure - Environment Template
# ==========================================
# Copy this file to .env and fill in appropriate values.
# NEVER commit the real .env file!

# --- General ---
TZ=Europe/Paris
PUID=1000
PGID=1000

# --- FileDrive ---
FILEDRIVE_PORT=3000
DATABASE_URL=sqlite:///var/lib/filedrive/filedrive.db
JWT_SECRET=your_jwt_secret_here

# --- n8n Stack ---
N8N_PORT=5678
N8N_HOST=0.0.0.0
GENERIC_TIMEZONE=Europe/Paris
WEBHOOK_URL=https://n8n.yourdomain.com/

# --- Minecraft Servers ---
MC_HEAP=-Xmx8G -Xms2G
MC_FLAGS=-XX:+UseG1GC

# --- Tunnels & VPN (Placeholders / Configured externally) ---
CLOUDFLARE_TUNNEL_TOKEN=
TAILSCALE_AUTHKEY=
PLAYIT_SECRET_KEY=
