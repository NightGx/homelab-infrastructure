[Unit]
Description=portfolio service (migrated from /home/thomas/portfolio)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/portfolio
ExecStart=/usr/bin/docker compose -f /opt/portfolio/docker-compose.yml up --remove-orphans
Restart=on-failure
RestartSec=5
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/portfolio

[Install]
WantedBy=multi-user.target
